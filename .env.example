# ============================================================
# 智构 StructMind · 部署环境变量说明
# 在 Vercel 控制台配置（Settings → Environment Variables），
# 不要提交真实 Key 到代码仓库！
# ============================================================

# 必填：DeepSeek API Key（服务端持有，前端不可见）
DEEPSEEK_API_KEY=sk-你的key

# 可选：上游 LLM 接口地址（OpenAI 兼容协议）
# 默认 https://api.deepseek.com/v1，支持通义千问等：
#   https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
